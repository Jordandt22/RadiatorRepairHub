# API Configuration (include version prefix, e.g. /v1/api)
API_URI=https://your-api-domain.com/v1/api
NEXT_PUBLIC_API_URI=https://your-api-domain.com/v1/api

# Business Information
BUSINESS_EMAIL=contact@radiatorrepairhub.com
WEB_URL=https://radiatorrepairhub.com

# Search Engine Verification
GOOGLE_VERIFICATION_ID=your-google-verification-id

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Maps API
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Cloudflare Images (business photos; custom domain rewrite under /images)
NEXT_PUBLIC_CF_IMAGES_BASE_URL=https://radiatorrepairhub.com/images
NEXT_PUBLIC_CF_IMAGES_ENV=dev

# On-demand revalidation (must match API server REVALIDATE_SECRET)
REVALIDATE_SECRET=replace-with-a-long-random-string
