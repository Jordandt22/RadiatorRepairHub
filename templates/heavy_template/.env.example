# Contact form API. No trailing slash.
NEXT_PUBLIC_API_URI=http://localhost:8000/v1/api

# Partner site key, sent as X-Site-Key. The form cannot reach a listing without it.
NEXT_PUBLIC_TEMPLATE_API_KEY=

# Public https origin for canonicals, the sitemap, Open Graph, and schema IDs.
# Local default when this is unset: http://localhost:3002.
# Set this on deploy. Vercel also provides VERCEL_URL, which is only a fallback.
NEXT_PUBLIC_SITE_URL=http://localhost:3002
